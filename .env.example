# Kopirajte v datoteko .env in prilagodite. Docker Compose jo prebere samodejno.

# Gesla skrbnikov ob prvem zagonu (kasneje jih spremenite v aplikaciji)
ADMIN_USER=admin
ADMIN_PASSWORD=Spremeni-me-2026

# Skupni žeton za VMS in AI modul – vpišite dolg naključen niz
AI_TOKEN=vpisite-dolg-nakljucen-niz-npr-40-znakov

# IP naslov računalnika, na katerem teče Docker Desktop (za WebRTC in dvosmerni zvok)
HOST_IP=192.168.1.10

# Mapa za posnetke na strežniku (Windows primer: D:/VisionOne/posnetki)
RECORDINGS_PATH=./recordings

# Vrata spletnih aplikacij
VMS_PORT=8080

# Število demo kamer ob prvem zagonu (0 = brez). Uporabno za preizkus brez prave kamere.
DEMO_CAMERAS=0

SYSTEM_NAME=VisionOne
TZ=Europe/Ljubljana

# AI model: yolo11n.pt (hiter), yolo11s.pt (natančnejši, počasnejši)
AI_MODEL=yolo11n.pt

# Oddaljen dostop https://vms.visionone.si (Cloudflare Zero Trust → Networks → Tunnels → žeton tunela)
# Ko je nastavljen, zagon.bat zažene tudi tunel.
TUNNEL_TOKEN=

# Ključ za podpis prijave in šifriranje gesel kamer (openssl rand -hex 32). Prazno = samodejno v data/vms/.secret
SECRET_KEY=
