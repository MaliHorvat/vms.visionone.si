# ───────────────────────── VisionOne portal – okoljske spremenljivke ─────────────────────────
# Kopiraj v Vercel → Project → Settings → Environment Variables (ali v .env za lokalni razvoj).

# ─── Baza (Neoserv MySQL/MariaDB) ───
# Oddaljeni dostop mora biti dovoljen v gostovanju (Remote MySQL). Uporabi SSL, če ga strežnik podpira.
DB_HOST=sqlXXX.neoserv.si
DB_PORT=3306
DB_USER=moj_uporabnik
DB_PASSWORD=moje_geslo
DB_NAME=moja_baza
DB_SSL=1                       # 1 = zahtevaj TLS (priporočeno); 0 = brez
DB_SSL_REJECT_UNAUTHORIZED=0   # 0, če ima gostovanje samopodpisan certifikat

# ─── Seje / piškotki ───
# Dolg naključen niz (vsaj 32 znakov). Generiraj: node scripts/keygen.js
SESSION_SECRET=zamenjaj_me_z_dolgim_nakljucnim_nizom

# ─── Prvi zagon / migracije ───
# Enkratni žeton za /api/setup (ustvari tabele + prvega skrbnika). Po namestitvi ga izbriši.
SETUP_TOKEN=zamenjaj_me

# ─── Licenčni podpis (Ed25519) ───
# Generiraj par: node scripts/keygen.js  → prilepi oba niza (base64).
# Javni ključ je vgrajen tudi v agenta (agent/pubkey.txt).
LICENSE_PRIVATE_KEY=
LICENSE_PUBLIC_KEY=

# ─── Telegram bot ───
TELEGRAM_BOT_TOKEN=
# Naključen niz; nastavi ga tudi ob registraciji webhooka (zaščita pred ponarejenimi klici).
TELEGRAM_WEBHOOK_SECRET=zamenjaj_me

# ─── Šifriranje gesel naprav, shranjenih v portalu (neobvezno) ───
# 32-bajtni ključ v base64 (node scripts/keygen.js ga izpiše). Hrani ga LOČENO od baze.
DEVICE_SECRET_KEY=

# ─── Splošno ───
PORTAL_URL=https://vms.visionone.si
# Po koliko sekundah brez poročila velja agent/naprava za nedosegljivo
OFFLINE_AFTER_SECONDS=180
